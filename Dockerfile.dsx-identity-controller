FROM --platform=$BUILDPLATFORM golang:1.25 AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/dsx-identity-controller/ ./cmd/dsx-identity-controller/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o dsx-identity-controller ./cmd/dsx-identity-controller

FROM debian:bookworm-slim
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /app/dsx-identity-controller /usr/local/bin/dsx-identity-controller
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/dsx-identity-controller"]
