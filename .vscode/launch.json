{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch CEL Evaluator",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/cel-evaluator",
            "args": [
                "config/cel-role.json"
            ],
            "cwd": "${workspaceFolder}",
            "env": {},
            "console": "integratedTerminal"
        },
        {
            "name": "Launch CEL Evaluator (Debug)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/cel-evaluator",
            "args": [
                "config/cel-role.json"
            ],
            "cwd": "${workspaceFolder}",
            "env": {},
            "console": "integratedTerminal",
            "showLog": true
        }
    ]
}
