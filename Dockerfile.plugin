ARG BUILDER_IMG=golang:1.26.4
ARG TOOLS_IMG=busybox:1.37.0-musl

FROM --platform=$BUILDPLATFORM ${BUILDER_IMG} AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
ARG BINARY
COPY cmd/${BINARY}/ ./cmd/${BINARY}/
COPY internal/ ./internal/
ARG TARGETOS
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /out/plugin ./cmd/${BINARY}

FROM ${TOOLS_IMG} AS tools

# this image essentially exists as a file holder.
# it is used to copy the plugins into a shared volume as an init container.
FROM scratch
COPY --from=tools /bin/busybox /bin/cp
COPY --from=builder /out/plugin /plugin
ENTRYPOINT ["/bin/cp", "-a", "/plugin"]
