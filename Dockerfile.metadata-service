# Build stage
# Use the build platform for compilation and cross-compile to the target platform.
FROM --platform=$BUILDPLATFORM golang:1.25 AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /app

# Copy go modules files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY cmd/metadata-service/ ./cmd/metadata-service/

# Build the binary
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o metadata-service ./cmd/metadata-service

# Final stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*


WORKDIR /root/

# Copy the binary from builder stage
COPY --from=builder /app/metadata-service .

# Run the metadata service
ENTRYPOINT ["/root/metadata-service"]
