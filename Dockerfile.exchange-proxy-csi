# Build stage
FROM golang:1.25 AS builder

WORKDIR /app

# Copy go modules files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY cmd/exchange-proxy-csi/ ./cmd/exchange-proxy-csi/

# Build the binary
RUN CGO_ENABLED=0 go build -o exchange-proxy-csi ./cmd/exchange-proxy-csi

# Final stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /root/

# Copy the binary from builder stage
COPY --from=builder /app/exchange-proxy-csi .

ENTRYPOINT ["/root/exchange-proxy-csi"]
