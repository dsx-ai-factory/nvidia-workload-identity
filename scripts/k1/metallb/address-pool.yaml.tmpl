apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: k1-pool
  namespace: metallb-system
spec:
  addresses:
    - SUBNET_PREFIX.255.200-SUBNET_PREFIX.255.210
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: k1-l2
  namespace: metallb-system
spec:
  ipAddressPools:
    - k1-pool
