{
  "name": "basic-spiffe",
  "cel_program": {
    "variables": [
      {
        "name": "is_spiffe",
        "expression": "claims.sub.matches(r'^spiffe://[^/]+\\.[^/]+\\.[^/]+/[^/]+/[^/]+/[^/]+$')"
      },
      {
        "name": "spiffe_parts",
        "expression": "is_spiffe ? claims.sub.substring(9).split('/') : []"
      },
      {
        "name": "trust_domain",
        "expression": "is_spiffe && size(spiffe_parts) > 0 ? spiffe_parts[0] : ''"
      },
      {
        "name": "domain_parts",
        "expression": "trust_domain != '' ? trust_domain.split('.') : []"
      },
      {
        "name": "tenant_id",
        "expression": "size(domain_parts) >= 1 ? domain_parts[0] : ''"
      },
      {
        "name": "region",
        "expression": "size(domain_parts) >= 2 ? domain_parts[1] : ''"
      },
      {
        "name": "product",
        "expression": "size(spiffe_parts) >= 2 ? spiffe_parts[1] : ''"
      },
      {
        "name": "resource_type",
        "expression": "size(spiffe_parts) >= 3 ? spiffe_parts[2] : ''"
      },
      {
        "name": "resource_id",
        "expression": "size(spiffe_parts) >= 4 ? spiffe_parts[3] : ''"
      }
    ],
    "expression": "is_spiffe ? pb.Auth{policies: ['spiffe-authenticated', 'region-' + region, 'tenant-' + tenant_id, 'product-' + product, 'resource-type-' + resource_type]} : false"
  },
  "expiration_leeway": 150,
  "not_before_leeway": 150,
  "clock_skew_leeway": 60,
  "bound_audiences": [
    "spiffe://sjc-1.k8s2-control.nvidia.com"
  ]
}