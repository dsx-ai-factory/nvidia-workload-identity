apiVersion: v1
kind: ServiceAccount
metadata:
  name: VM_NAME_PLACEHOLDER-imds-client
  namespace: tenant-TENANT_PLACEHOLDER
automountServiceAccountToken: false
---
apiVersion: v1
kind: Pod
metadata:
  name: VM_NAME_PLACEHOLDER-imds-client
  namespace: tenant-TENANT_PLACEHOLDER
  labels:
    app: dsx-imds-e2e-client
spec:
  serviceAccountName: VM_NAME_PLACEHOLDER-imds-client
  automountServiceAccountToken: false
  restartPolicy: Never
  securityContext:
    seccompProfile:
      type: RuntimeDefault
  containers:
    - name: ssh-client
      image: SSH_CLIENT_IMAGE_PLACEHOLDER
      imagePullPolicy: IfNotPresent
      command: ["tail", "-f", "/dev/null"]
      resources:
        requests:
          cpu: 10m
          memory: 32Mi
        limits:
          cpu: 100m
          memory: 128Mi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop: ["ALL"]
        readOnlyRootFilesystem: true
      volumeMounts:
        - name: ssh-key
          mountPath: /run/dsx-identity-ssh
          readOnly: true
  volumes:
    - name: ssh-key
      secret:
        secretName: VM_NAME_PLACEHOLDER-e2e-ssh
        defaultMode: 0400
        items:
          - key: id_ed25519
            path: id_ed25519
