# Build stage
FROM --platform=$BUILDPLATFORM golang:1.25 AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /app

# Copy go modules files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY cmd/spiffe-exchange-service/ ./cmd/spiffe-exchange-service/

# Build the binary (cross-compiled for the target arch)
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o spiffe-exchange-service ./cmd/spiffe-exchange-service

# Final stage
FROM debian:bookworm-slim

# ca-certificates for TLS (copied from builder; no RUN to keep the stage emulation-free)
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

WORKDIR /root/

# Copy the binary from builder stage
COPY --from=builder /app/spiffe-exchange-service .

# Run the exchange service
ENTRYPOINT ["/root/spiffe-exchange-service"]
