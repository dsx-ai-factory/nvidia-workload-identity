apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: metadata-service-TENANT_PLACEHOLDER
  namespace: default
  labels:
    app: metadata-service
    tenant: TENANT_PLACEHOLDER
spec:
  selector:
    matchLabels:
      app: metadata-service
      tenant: TENANT_PLACEHOLDER
  template:
    metadata:
      labels:
        app: metadata-service
        tenant: TENANT_PLACEHOLDER
        network: tenant-TENANT_PLACEHOLDER-network
      annotations:
        k8s.v1.cni.cncf.io/networks: tenant-TENANT_PLACEHOLDER-network
    spec:
      nodeSelector:
        vm-tenant: TENANT_PLACEHOLDER
      containers:
      - name: nginx
        image: nginx:1.27-alpine
        ports:
        - containerPort: 80
          name: http
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
          limits:
            cpu: 200m
            memory: 256Mi

