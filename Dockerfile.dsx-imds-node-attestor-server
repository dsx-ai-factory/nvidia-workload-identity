FROM --platform=$BUILDPLATFORM golang:1.25 AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY internal/ ./internal/
COPY cmd/dsx-imds-node-attestor-server/ ./cmd/dsx-imds-node-attestor-server/
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /dsx-imds-node-attestor-server ./cmd/dsx-imds-node-attestor-server

FROM debian:bookworm-slim
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /dsx-imds-node-attestor-server /usr/local/bin/
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/dsx-imds-node-attestor-server"]
