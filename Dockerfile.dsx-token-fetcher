# Build stage
FROM --platform=$BUILDPLATFORM golang:1.25 AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /app

# Copy go modules files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY cmd/dsx-token-fetcher/ ./cmd/dsx-token-fetcher/
COPY internal/ ./internal/

# Build the binary
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o dsx-token-fetcher ./cmd/dsx-token-fetcher

# Final stage
FROM debian:bookworm-slim

# ca-certificates for HTTPS Exchange endpoints
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

WORKDIR /root/

# Copy the binary from builder stage
COPY --from=builder /app/dsx-token-fetcher .

# Run the token fetcher
ENTRYPOINT ["/root/dsx-token-fetcher"]
