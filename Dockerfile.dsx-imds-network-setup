# Build stage
FROM --platform=$BUILDPLATFORM golang:1.25 AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /app

# Copy go modules files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY cmd/dsx-imds-network-setup/ ./cmd/dsx-imds-network-setup/

# Build the binary
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o dsx-imds-network-setup ./cmd/dsx-imds-network-setup

# Final stage
FROM debian:bookworm-slim

WORKDIR /root/

# Copy the binary from builder stage
COPY --from=builder /app/dsx-imds-network-setup .

ENTRYPOINT ["/root/dsx-imds-network-setup"]
